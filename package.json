{
  "name": "nexus-edu",
  "version": "1.1.1",
  "description": "Dashboard de evaluación y calificación de alumnos — Nexus-Edu",
  "main": "./out/main/index.js",
  "author": "Nexus-Edu",
  "homepage": "https://github.com/GyGSol/Nexus-Edu",
  "repository": {
    "type": "git",
    "url": "https://github.com/GyGSol/Nexus-Edu.git"
  },
  "desktopName": "nexus-edu.desktop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "node scripts/run-with-clean-env.mjs electron-vite preview",
    "dev": "node scripts/run-with-clean-env.mjs electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "dist": "pnpm run build && electron-builder --linux",
    "dist:win": "pnpm run build:win",
    "dist:linux": "pnpm run build:linux",
    "release:win": "pnpm run build && electron-builder --win --x64 --publish always",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-with-clean-env.mjs playwright test",
    "test": "pnpm run test:unit && pnpm run test:e2e"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/literata": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
